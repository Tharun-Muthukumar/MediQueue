# Copy to .env (the setup script does this for you). Never commit .env.
# MySQL 8 connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE (see docs/mysql.md)
DATABASE_URL="mysql://mediqueue:mediqueue123@localhost:3306/mediqueue"
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Replace with 32+ random characters. Used to sign session and CSRF cookies.
SESSION_SECRET=replace-with-32-plus-random-characters-please
SESSION_TTL_HOURS=12
CLINIC_TIMEZONE=Asia/Kolkata
TZ=UTC
NODE_ENV=development
# Set to true to let the no-show job run every minute (clinic setting must also allow it)
ENABLE_JOBS=true
